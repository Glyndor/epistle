# Sample systemd unit for the epistle mail server.
#
# Install:
#   install -Dm644 docs/epistle.service /etc/systemd/system/epistle.service
#   install -d -m 0750 -o glyndor-epistle -g glyndor-epistle /etc/epistle
#   install -m 0600 -o glyndor-epistle -g glyndor-epistle epistle.toml /etc/epistle/mail.toml
#   systemctl daemon-reload && systemctl enable --now epistle
#
# The config is owned by the account the service runs as, on purpose. The
# service has only CAP_NET_BIND_SERVICE and no CAP_DAC_OVERRIDE, so an
# `install -Dm600` from a root shell leaves it 0600 root:root and the server
# cannot read the file it was told to serve. /etc/epistle is the directory the
# package's postinst prepares and the path `epistle` reads by default.
#
# The unit runs epistle as the persistent, unprivileged `glyndor-epistle`
# account that the .deb creates from its postinst, with the filesystem locked
# down. Because the service is already that user, the config's [privileges]
# section is unnecessary here: the drop is a no-op when the process is already
# exactly the requested user (src/privdrop/mod.rs, drop_to). Install the package
# first, or create the account by hand, or systemd will refuse to start the
# service with a user it cannot resolve.
#
# CAP_NET_BIND_SERVICE lets it bind the low mail ports (25/465/587/993/995)
# without root; drop the capability lines if you only use high ports.
# ReadWritePaths must match the config's data_dir.
#
# The Glyndor prefix is on the whole footprint: the account, /etc/epistle and
# the StateDirectory under /var/lib/glyndor/epistle.
#
# Running `epistle serve` straight from the package like this is for a
# single-host, non-container deployment; the supported production shape is the
# rootless Podman stack under this same account.

[Unit]
Description=epistle mail server (SMTP, IMAP, email security)
Documentation=https://github.com/Glyndor/epistle
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/epistle serve --config /etc/epistle/mail.toml
Restart=on-failure
RestartSec=5s

# Every connection is a file descriptor. The default soft limit (1024) is
# reached around a thousand idle connections, after which the listeners stop
# greeting. The listener caps together (SMTP 1000, IMAP and POP3 500,
# ManageSieve 100, HTTP 1024) plus the spool and the logs fit well under this.
LimitNOFILE=65536

# Run as the persistent, unprivileged account the package creates, with its own
# state dir. UMask + StateDirectoryMode keep the mailbox and the credential/TOTP
# stores owner-only (0700): the server writes secrets 0600, and nothing above
# them should be group- or world-readable.
User=glyndor-epistle
Group=glyndor-epistle
UMask=0077
StateDirectory=glyndor/epistle/data
StateDirectoryMode=0700
ReadWritePaths=/var/lib/glyndor/epistle/data

# Only the two capabilities needed to bind privileged ports; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem and kernel hardening: read-only system, no device or kernel access,
# private tmp, and a minimal address-family / syscall surface.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
