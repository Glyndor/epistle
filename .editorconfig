root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Mail fixtures keep their bytes: trailing spaces in a body are part of the test.
[tests/fixtures/*.mbox]
trim_trailing_whitespace = false

# DER timestamp replies kept as test data are binary: no line endings, no
# final newline, no charset.
[*.tsr]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# DKIM fixtures are signed bytes: CRLF line ends, trailing whitespace and the
# exact final bytes belong to the test.
[tests/fixtures/dkim/**/*.{eml,dns,input,unsigned}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# The frozen storage key of the v0.12.5 credential stores is exactly the bytes
# the release wrote, without a final newline.
[tests/contracts/testdata/credentials-*/encryption.key]
insert_final_newline = unset
