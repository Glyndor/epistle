{
 "True": {
  "merge_group": {
   "types": [
    "checks_requested"
   ]
  },
  "pull_request": null
 },
 "concurrency": {
  "cancel-in-progress": "${{ github.event_name == 'pull_request' }}",
  "group": "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}"
 },
 "jobs": {
  "cancel-others": {
   "if": "${{ failure() && github.event_name == 'pull_request' }}",
   "needs": [
    "dco",
    "noreply",
    "secret-scan"
   ],
   "permissions": {
    "actions": "write",
    "contents": "read"
   },
   "uses": "./.github/workflows/reusable-cancel-others.yml"
  },
  "dco": {
   "uses": "./.github/workflows/reusable-dco.yml"
  },
  "noreply": {
   "name": "author and sign-off use a GitHub noreply address",
   "runs-on": "${{ fromJSON(vars.CI_RUNNER || '\"ubuntu-latest\"') }}",
   "steps": [
    {
     "uses": "actions/checkout@PIN",
     "with": {
      "fetch-depth": 0,
      "persist-credentials": false
     }
    },
    {
     "env": {
      "BASE_SHA": "${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha }}",
      "HEAD_SHA": "${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha }}"
     },
     "name": "Check author and trailer addresses",
     "run": "bash .github/scripts/check_noreply_signoff.sh \"$BASE_SHA\" \"$HEAD_SHA\""
    }
   ],
   "timeout-minutes": 3
  },
  "secret-scan": {
   "name": "no credential-shaped line is added",
   "runs-on": "${{ fromJSON(vars.CI_RUNNER || '\"ubuntu-latest\"') }}",
   "steps": [
    {
     "uses": "actions/checkout@PIN",
     "with": {
      "fetch-depth": 0,
      "persist-credentials": false
     }
    },
    {
     "env": {
      "BASE_SHA": "${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha }}",
      "HEAD_SHA": "${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha }}"
     },
     "name": "Scan what this change adds, every commit of it and every message",
     "run": "set -euo pipefail\ndir=scripts/scan-credentials\ngit rev-parse --verify \"$BASE_SHA^{commit}\" > /dev/null || { echo \"::error::the base $BASE_SHA cannot be read, so nothing was scanned\"; exit 1; }\nscanner=\"\"\nfor name in check-secrets.sh scan-credentials.sh; do\n  if git cat-file -e \"$BASE_SHA:$dir/$name\" 2>/dev/null; then\n    mkdir -p \"$RUNNER_TEMP/scanner\"\n    git archive \"$BASE_SHA\" \"$dir/$name\" | tar -x -C \"$RUNNER_TEMP/scanner\"\n    scanner=\"$RUNNER_TEMP/scanner/$dir/$name\"\n    break\n  fi\ndone\n[ -n \"$scanner\" ] || { echo \"::error::the base has no secret scan, so nothing was scanned\"; exit 1; }\nbash \"$scanner\" \"$BASE_SHA\" \"$HEAD_SHA\"\n"
    }
   ],
   "timeout-minutes": 5
  }
 },
 "name": "DCO",
 "permissions": {
  "contents": "read"
 }
}
