#!/usr/bin/make -f

export CARGO_HOME = $(CURDIR)/debian/cargo-home
# Pin the target dir so a CARGO_TARGET_DIR from the environment cannot move the
# binary away from the path the install step expects.
export CARGO_TARGET_DIR = $(CURDIR)/target
# The queries are checked against the committed .sqlx cache, so the build needs
# no database and no network to reach one.
export SQLX_OFFLINE = true

# When a vendor/ directory is present (offline/air-gapped builds), configure
# Cargo to use it exclusively. The vendor/ tree is generated by running
# `cargo vendor vendor` at the repository root and including the output in the
# source tarball.
ifneq ($(wildcard vendor/),)
export CARGO_NET_OFFLINE = true
CARGO_FLAGS = --frozen --offline
endif

%:
	dh $@

override_dh_auto_build:
ifneq ($(wildcard vendor/),)
	$(if $(wildcard .cargo/config.toml),,$(MAKE) -f debian/rules debian/cargo-config)
endif
	cargo build --release --locked $(CARGO_FLAGS)

# The unit tests that touch a live PostgreSQL are gated on DATABASE_URL and skip
# without it, so this runs the rest. The database-backed suite runs in CI
# (db.yml) against a real server, which is the only place it means anything.
override_dh_auto_test:
	cargo test --release --locked $(CARGO_FLAGS)

override_dh_auto_install:
	install -D -m 0755 target/release/epistle debian/epistle/usr/bin/epistle

override_dh_auto_clean:
	cargo clean
	rm -rf debian/cargo-home
	# A vendored build writes .cargo/config.toml pointing at vendor/; drop it so a
	# later non-vendored build does not fail on missing vendored sources.
	rm -f .cargo/config.toml

# Generate .cargo/config.toml pointing at the vendor tree (only when vendored).
debian/cargo-config:
ifneq ($(wildcard vendor/),)
	mkdir -p .cargo
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' > .cargo/config.toml
endif
