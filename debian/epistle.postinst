#!/bin/sh
# Post-installation script for the epistle package.
#
# This prepares the isolated glyndor-epistle account that the documentation and
# the sample unit expect: the account itself, its state directory, the
# subuid/subgid ranges rootless Podman needs, the systemd linger flag, and the
# sysctl that lets the account bind port 25.
#
# The division of labour is deliberate. This script attempts each step and
# warns on stderr when one does not take, and it never aborts the
# installation: a package that refuses to install on a read-only /etc, or in an
# image where systemd is not running, is worse than one that reports what is
# missing. `epistle init` is the other half. It verifies the resulting state
# and refuses to continue when something this script could not do is still
# missing.

set -e

# Print the lowest id at or above $1 that starts a block of $3 ids ending at or
# below $2 and overlapping no entry of the subordinate id files named after
# them; return 1 when there is none. A missing file counts as empty. Each pass
# moves the candidate past every entry it overlaps, so it stops at the first
# block that fits whole, whatever order the entries are in.
epistle_free_subid_start() {
	subid_min=$1
	subid_max=$2
	subid_size=$3
	shift 3
	cat -- "$@" 2>/dev/null | awk -F: -v min="$subid_min" -v max="$subid_max" -v size="$subid_size" '
		$2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 > 0 { n++; lo[n] = $2 + 0; hi[n] = $2 + $3 - 1 }
		END {
			start = min + 0
			moved = 1
			while (moved) {
				moved = 0
				for (i = 1; i <= n; i++) {
					if (lo[i] <= start + size - 1 && hi[i] >= start) {
						start = hi[i] + 1
						moved = 1
					}
				}
			}
			if (start + size - 1 > max + 0) exit 1
			printf "%d\n", start
		}'
}

# Return 0 when a range glyndor-epistle holds in table $1 shares ids with a
# range another account holds there.
epistle_subid_overlaps() {
	cat -- "$1" 2>/dev/null | awk -F: '
		$2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 > 0 {
			n++; who[n] = $1; lo[n] = $2 + 0; hi[n] = $2 + $3 - 1
		}
		END {
			for (i = 1; i <= n; i++) {
				if (who[i] != "glyndor-epistle") continue
				for (j = 1; j <= n; j++) {
					if (who[j] != "glyndor-epistle" && lo[i] <= hi[j] && lo[j] <= hi[i]) exit 0
				}
			}
			exit 1
		}'
}

# Print the size of the first range glyndor-epistle holds in the tables named,
# or 65536 when it holds none.
epistle_account_subid_size() {
	cat -- "$@" 2>/dev/null | awk -F: '
		$1 == "glyndor-epistle" && $3 ~ /^[0-9]+$/ && $3 > 0 && size == "" { size = $3 }
		END { print (size == "" ? 65536 : size) }'
}

# Print the numeric value of login.defs key $1 from file $3, or $2 when the
# key is absent or commented out.
epistle_login_def() {
	cat -- "$3" 2>/dev/null | awk -v key="$1" -v def="$2" '
		$1 == key && $2 ~ /^[0-9]+$/ { value = $2 }
		END { print (value == "" ? def : value) }'
}

# Print "<uid start> <gid start>" for a new block of $4 subordinate ids
# (65536 when $4 is absent), given login.defs ($1), the subuid table ($2) and
# the subgid table ($3). The block honours SUB_UID_MIN/MAX and SUB_GID_MIN/MAX
# and overlaps no existing entry. The same start serves both tables when one
# is free in both, so the uid and gid mappings line up; otherwise each table
# gets its own.
epistle_subid_starts() {
	subid_size=${4:-65536}
	uid_min=$(epistle_login_def SUB_UID_MIN 100000 "$1")
	uid_max=$(epistle_login_def SUB_UID_MAX 600100000 "$1")
	gid_min=$(epistle_login_def SUB_GID_MIN 100000 "$1")
	gid_max=$(epistle_login_def SUB_GID_MAX 600100000 "$1")
	common_min=$uid_min
	if [ "$gid_min" -gt "$common_min" ]; then
		common_min=$gid_min
	fi
	common_max=$uid_max
	if [ "$gid_max" -lt "$common_max" ]; then
		common_max=$gid_max
	fi
	if common=$(epistle_free_subid_start "$common_min" "$common_max" "$subid_size" "$2" "$3"); then
		echo "$common $common"
		return 0
	fi
	uid_start=$(epistle_free_subid_start "$uid_min" "$uid_max" "$subid_size" "$2") || return 1
	gid_start=$(epistle_free_subid_start "$gid_min" "$gid_max" "$subid_size" "$3") || return 1
	echo "$uid_start $gid_start"
}

case "$1" in
configure)
	# 1. The account. --no-create-home because the state directory is created
	# below with the mode the server needs rather than the skeleton's.
	if ! getent passwd glyndor-epistle >/dev/null 2>&1; then
		adduser --system --group --quiet \
			--home /var/lib/glyndor/epistle --no-create-home \
			--shell /usr/sbin/nologin --disabled-password glyndor-epistle
	fi

	if [ ! -d /var/lib/glyndor/epistle ]; then
		install -d -m 0700 -o glyndor-epistle -g glyndor-epistle \
			/var/lib/glyndor/epistle
	fi

	if [ ! -e /var/lib/glyndor/epistle/data ] && [ ! -L /var/lib/glyndor/epistle/data ]; then
		install -d -m 0700 -o glyndor-epistle -g glyndor-epistle \
			/var/lib/glyndor/epistle/data
	fi

	if [ ! -e /etc/epistle ]; then
		install -d -m 0750 -o glyndor-epistle -g glyndor-epistle /etc/epistle
	fi

	# 2. The subordinate id ranges rootless Podman maps into its containers.
	# Without them `podman` refuses to start a container as this user. The
	# block must be one no other account holds: useradd gives the first regular
	# user 100000 onwards by default, and two accounts mapping the same host ids
	# can each own the other's container files.
	ranges_added=false
	if ! grep -q '^glyndor-epistle:' /etc/subuid 2>/dev/null || ! grep -q '^glyndor-epistle:' /etc/subgid 2>/dev/null; then
		subid_args=
		if subid_starts=$(epistle_subid_starts /etc/login.defs /etc/subuid /etc/subgid); then
			uid_start=${subid_starts% *}
			gid_start=${subid_starts#* }
			if ! grep -q '^glyndor-epistle:' /etc/subuid 2>/dev/null; then
				subid_args="--add-subuids $uid_start-$((uid_start + 65535))"
			fi
			if ! grep -q '^glyndor-epistle:' /etc/subgid 2>/dev/null; then
				subid_args="$subid_args --add-subgids $gid_start-$((gid_start + 65535))"
			fi
		fi
		# $subid_args is left unquoted on purpose: it holds options and
		# numeric ranges only, and each must reach usermod as its own word.
		# shellcheck disable=SC2086
		if [ -z "$subid_args" ]; then
			echo "epistle: no free block of 65536 subordinate ids for glyndor-epistle within SUB_UID_MIN/MAX and SUB_GID_MIN/MAX of /etc/login.defs; rootless Podman will not start until it has one" >&2
		elif ! usermod $subid_args glyndor-epistle; then
			echo "epistle: could not add the subuid/subgid ranges for glyndor-epistle; rootless Podman will not start until they exist" >&2
		else
			ranges_added=true
		fi
	fi

	# 3. Linger, so the account's user manager (and with it the rootless stack)
	# runs without an open session. Only meaningful when systemd is running.
	if [ -d /run/systemd/system ]; then
		if ! loginctl enable-linger glyndor-epistle; then
			echo "epistle: loginctl enable-linger glyndor-epistle failed; the rootless services will not start at boot" >&2
		fi
	else
		echo "epistle: systemd is not running, so linger was not enabled for glyndor-epistle; epistle init will check it" >&2
	fi

	# podup speaks the libpod API rather than invoking the Podman CLI.
	if [ -d /run/systemd/system ]; then
		(
			service_uid=$(id -u glyndor-epistle) || exit 0
			service_runtime=/run/user/$service_uid
			if [ -d "$service_runtime" ]; then
				if ! runuser -u glyndor-epistle -- env \
					XDG_RUNTIME_DIR="$service_runtime" \
					DBUS_SESSION_BUS_ADDRESS="unix:path=$service_runtime/bus" \
					systemctl --user enable --now podman.socket; then
					echo "epistle: could not enable the Podman API socket; run systemctl --user enable --now podman.socket as glyndor-epistle" >&2
				fi
			fi
		)
	fi

	# 4. Prepare the rootless Podman runtime for the new ranges. Podman arrives
	# through podup, a Depends, so it is only absent under --force-depends.
	if [ "$ranges_added" = true ] && [ -z "${2:-}" ] && command -v podman >/dev/null 2>&1; then
		if ! runuser -u glyndor-epistle -- podman system migrate; then
			echo "epistle: podman system migrate failed for glyndor-epistle; epistle init will check the rootless runtime" >&2
		fi
	fi

	# 5. The port floor shipped in /usr/lib/sysctl.d/30-glyndor-epistle.conf.
	if [ -w /proc/sys/net/ipv4/ip_unprivileged_port_start ] && command -v sysctl >/dev/null 2>&1; then
		if ! sysctl -p /usr/lib/sysctl.d/30-glyndor-epistle.conf >/dev/null; then
			echo "epistle: sysctl -p /usr/lib/sysctl.d/30-glyndor-epistle.conf failed, so the unprivileged port floor may still be above 25; epistle init will check it" >&2
		fi
	else
		echo "epistle: could not apply /usr/lib/sysctl.d/30-glyndor-epistle.conf; epistle init will check the unprivileged port floor" >&2
	fi

	# 6. Packages up to 0.10.1 gave the account a fixed block that useradd also
	# gives the first regular user, and the step above never moves a block the
	# account already holds. On upgrade, an overlap is moved to a free block of
	# the same size, chosen by the allocator a fresh install uses. `epistle
	# move-subids` stops the stack, rewrites only the account's lines, shifts
	# the owner of its container files, starts the stack again, and puts all
	# of it back when a step fails. It runs before `stack update` below so the
	# stack that update restarts is already on the new block.
	if [ -n "${2:-}" ] && { epistle_subid_overlaps /etc/subuid || epistle_subid_overlaps /etc/subgid; }; then
		subid_size=$(epistle_account_subid_size /etc/subuid /etc/subgid)
		if ! subid_starts=$(epistle_subid_starts /etc/login.defs /etc/subuid /etc/subgid "$subid_size"); then
			echo "epistle: glyndor-epistle shares subordinate ids with another account and there is no free block of $subid_size ids within SUB_UID_MIN/MAX and SUB_GID_MIN/MAX to move it to; epistle check subid shows the overlap" >&2
		elif ! epistle move-subids --uid-start "${subid_starts% *}" --gid-start "${subid_starts#* }"; then
			echo "epistle: could not move the subordinate ids of glyndor-epistle (see the message above for what was left in place); run sudo dpkg-reconfigure epistle to try again" >&2
		fi
	fi

	# Only an enabled stack opts into automatic image updates on apt upgrades.
	if [ -n "${2:-}" ] && [ -f /var/lib/glyndor/epistle/.config/systemd/user/podup-epistle.service ]; then
		(
			service_uid=$(id -u glyndor-epistle) || exit 0
			HOME=/var/lib/glyndor/epistle
			XDG_RUNTIME_DIR=/run/user/$service_uid
			DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
			export HOME XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS
			cd "$HOME" || exit 0
			if runuser -u glyndor-epistle -- systemctl --user is-enabled --quiet podup-epistle.service; then
				if ! runuser -u glyndor-epistle -- epistle stack update; then
					echo "epistle: stack update failed; run sudo epistle stack update to retry" >&2
				fi
			fi
		)
	fi
	;;
esac

#DEBHELPER#

exit 0
