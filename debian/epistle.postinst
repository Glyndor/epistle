#!/bin/sh
# Post-installation script for the epistle package.
#
# This prepares the isolated glyndor-epistle account that the documentation and
# the sample unit expect: the account itself, its state directory, the
# subuid/subgid ranges rootless Podman needs, the systemd linger flag, and the
# sysctl that lets the account bind port 25.
#
# The division of labour is deliberate. This script attempts each step and
# warns on stderr when one does not take, and it never aborts the
# installation: a package that refuses to install on a read-only /etc, or in an
# image where systemd is not running, is worse than one that reports what is
# missing. `epistle init` is the other half. It verifies the resulting state
# and refuses to continue when something this script could not do is still
# missing.
#
# Several steps depend on something another process finishes a moment later:
# the lock on /etc/subuid, the name service answering for an account just
# created, the user manager that linger starts in the background and its bus.
# Each of those is tried a bounded number of times, two seconds apart, before
# it is reported. A step that still fails names what failed and the command
# that repeats it, and the script goes on and exits 0, so that the script can
# be run again (`dpkg-reconfigure epistle`) and each step does only what is
# still missing.

set -e

# Run the command made of the words after $1 up to $1 times, two seconds
# apart; succeed on the first attempt that does and fail after the last one.
# A command that exits 70 reports a cause waiting cannot remove: it is not run
# again and the status is passed on.
epistle_retry() {
	retry_max=$1
	shift
	retry_try=1
	while :; do
		"$@" && return 0
		retry_status=$?
		if [ "$retry_status" -eq 70 ]; then
			return 70
		fi
		if [ "$retry_try" -ge "$retry_max" ]; then
			return 1
		fi
		retry_try=$((retry_try + 1))
		sleep 2
	done
}

# Create the service account unless it exists. The lookup runs again on every
# attempt, so an attempt that created the account before it failed is not
# repeated.
epistle_add_account() {
	if getent passwd glyndor-epistle >/dev/null 2>&1; then
		return 0
	fi
	adduser --system --group --quiet \
		--home /var/lib/glyndor/epistle --no-create-home \
		--shell /usr/sbin/nologin --disabled-password glyndor-epistle
}

# Create directory $2 with mode $1 for the service account. The account can
# be created a moment before a cached name service answers for it, which
# makes `install` fail with an unknown user, so it is tried again.
epistle_install_dir() {
	if ! epistle_retry 5 install -d -m "$1" -o glyndor-epistle -g glyndor-epistle "$2"; then
		echo "epistle: could not create $2 for glyndor-epistle; run sudo dpkg-reconfigure epistle to try again" >&2
	fi
}

# Warn about directory $1 when it exists but is not owned by the service
# account or allows more than mode $2. Nothing is changed: the directory may
# hold mail or credentials, and what to do with it is the operator's call.
epistle_check_dir() {
	if [ -d "$1" ] && [ ! -L "$1" ]; then
		check_owner=$(stat -c '%U:%G' -- "$1" 2>/dev/null) || check_owner=unknown
		check_mode=$(stat -c '%a' -- "$1" 2>/dev/null) || check_mode=777
		if [ "$check_owner" != glyndor-epistle:glyndor-epistle ] ||
			[ "$((0$check_mode & ~0$2 & 0777))" -ne 0 ]; then
			echo "epistle: $1 is owned by $check_owner with mode $check_mode, not glyndor-epistle:glyndor-epistle with mode $2 or stricter; if that is not intended, run sudo chown glyndor-epistle:glyndor-epistle $1 && sudo chmod $2 $1" >&2
		fi
	fi
}

# Add the subordinate id block the account lacks to each table that holds no
# range of it yet. The free block is chosen again on every attempt, since
# another tool may have taken the one chosen before, and the tables are read
# again, so a retry never adds a range twice. Exit 70 when no block is free.
epistle_add_subids() {
	if ! add_starts=$(epistle_subid_starts /etc/login.defs /etc/subuid /etc/subgid); then
		echo "epistle: no free block of 65536 subordinate ids for glyndor-epistle within SUB_UID_MIN/MAX and SUB_GID_MIN/MAX of /etc/login.defs; rootless Podman will not start until it has one" >&2
		return 70
	fi
	add_uid=${add_starts% *}
	add_gid=${add_starts#* }
	add_args=
	if ! grep -q '^glyndor-epistle:' /etc/subuid 2>/dev/null; then
		add_args="--add-subuids $add_uid-$((add_uid + 65535))"
	fi
	if ! grep -q '^glyndor-epistle:' /etc/subgid 2>/dev/null; then
		add_args="$add_args --add-subgids $add_gid-$((add_gid + 65535))"
	fi
	if [ -z "$add_args" ]; then
		return 0
	fi
	# $add_args is left unquoted on purpose: it holds options and numeric
	# ranges only, and each must reach usermod as its own word.
	# shellcheck disable=SC2086
	usermod $add_args glyndor-epistle
}

# Print the lowest id at or above $1 that starts a block of $3 ids ending at or
# below $2 and overlapping no entry of the subordinate id files named after
# them; return 1 when there is none. A missing file counts as empty. Each pass
# moves the candidate past every entry it overlaps, so it stops at the first
# block that fits whole, whatever order the entries are in.
epistle_free_subid_start() {
	subid_min=$1
	subid_max=$2
	subid_size=$3
	shift 3
	cat -- "$@" 2>/dev/null | awk -F: -v min="$subid_min" -v max="$subid_max" -v size="$subid_size" '
		$2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 > 0 { n++; lo[n] = $2 + 0; hi[n] = $2 + $3 - 1 }
		END {
			start = min + 0
			moved = 1
			while (moved) {
				moved = 0
				for (i = 1; i <= n; i++) {
					if (lo[i] <= start + size - 1 && hi[i] >= start) {
						start = hi[i] + 1
						moved = 1
					}
				}
			}
			if (start + size - 1 > max + 0) exit 1
			printf "%d\n", start
		}'
}

# Return 0 when a range glyndor-epistle holds in table $1 shares ids with a
# range another account holds there.
epistle_subid_overlaps() {
	cat -- "$1" 2>/dev/null | awk -F: '
		$2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 > 0 {
			n++; who[n] = $1; lo[n] = $2 + 0; hi[n] = $2 + $3 - 1
		}
		END {
			for (i = 1; i <= n; i++) {
				if (who[i] != "glyndor-epistle") continue
				for (j = 1; j <= n; j++) {
					if (who[j] != "glyndor-epistle" && lo[i] <= hi[j] && lo[j] <= hi[i]) exit 0
				}
			}
			exit 1
		}'
}

# Print the size of the first range glyndor-epistle holds in the tables named,
# or 65536 when it holds none.
epistle_account_subid_size() {
	cat -- "$@" 2>/dev/null | awk -F: '
		$1 == "glyndor-epistle" && $3 ~ /^[0-9]+$/ && $3 > 0 && size == "" { size = $3 }
		END { print (size == "" ? 65536 : size) }'
}

# Print the numeric value of login.defs key $1 from file $3, or $2 when the
# key is absent or commented out.
epistle_login_def() {
	cat -- "$3" 2>/dev/null | awk -v key="$1" -v def="$2" '
		$1 == key && $2 ~ /^[0-9]+$/ { value = $2 }
		END { print (value == "" ? def : value) }'
}

# Read only regular, bounded configuration. A nonblocking open and a deadline
# also cover a file replaced after the metadata check. Ignore unusable input
# with a warning rather than blocking or failing package configuration.
epistle_read_sysctl() {
	LC_ALL=C
	export LC_ALL
	sysctl_file=$1
	if [ ! -f "$sysctl_file" ] || [ ! -r "$sysctl_file" ] ||
		! sysctl_size=$(timeout -k 1 2 stat -Lc %s -- "$sysctl_file" 2>/dev/null) ||
		[ "$sysctl_size" -gt 65536 ]; then
		echo "epistle: ignoring unusable sysctl configuration $sysctl_file" >&2
		return 0
	fi
	if ! sysctl_text=$(timeout -k 1 2 dd if="$sysctl_file" iflag=nonblock,count_bytes count=65537 status=none 2>/dev/null) ||
		[ "${#sysctl_text}" -gt 65536 ]; then
		echo "epistle: ignoring unreadable or oversized sysctl configuration $sysctl_file" >&2
		return 0
	fi
	printf '%s\n' "$sysctl_text"
}

# Select each basename from the highest priority directory, then read the
# selected files in global filename order. procps reads sysctl.conf last.
# Skip only our own vendor file when looking for an administrative choice.
epistle_admin_sysctl_value() {
	(
		for sysctl_dir in /etc/sysctl.d /run/sysctl.d /usr/lib/sysctl.d; do
			for sysctl_path in "$sysctl_dir"/*.conf; do
				[ -e "$sysctl_path" ] || [ -L "$sysctl_path" ] || continue
				printf '%s\n' "${sysctl_path##*/}"
			done
		done | LC_ALL=C sort -u | while IFS= read -r sysctl_name; do
			for sysctl_dir in /etc/sysctl.d /run/sysctl.d /usr/lib/sysctl.d; do
				sysctl_path=$sysctl_dir/$sysctl_name
				[ -e "$sysctl_path" ] || [ -L "$sysctl_path" ] || continue
				if [ "$sysctl_path" != /usr/lib/sysctl.d/30-glyndor-epistle.conf ] &&
					[ "$(readlink -f -- "$sysctl_path" 2>/dev/null)" != /dev/null ]; then
					epistle_read_sysctl "$sysctl_path"
				fi
				break
			done
		done
		if [ -e /etc/sysctl.conf ] || [ -L /etc/sysctl.conf ]; then
			epistle_read_sysctl /etc/sysctl.conf
		fi
	) | awk -F= '
		/^[[:space:]]*[#;]/ { next }
		NF >= 2 {
			name = $1
			value = $2
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
			sub(/^-/, "", name)
			gsub(/\//, ".", name)
			gsub(/[[:space:]]/, "", value)
			if (name != "" && value != "") print name, value
		}' | while read -r sysctl_key sysctl_value; do
		# sysctl accepts glob keys as well as exact names.
		# shellcheck disable=SC2254
		case "$1" in $sysctl_key) printf '%s\n' "$sysctl_value" ;; esac
	done | tail -n 1
}

# Succeed when a file in the operator's directories replaces the package file
# by name, which is how sysctl masks one: /etc/sysctl.d/30-glyndor-epistle.conf
# takes the place of /usr/lib/sysctl.d/30-glyndor-epistle.conf outright, and
# this package must not apply the file that is no longer in effect.
epistle_sysctl_masked() {
	[ -e /run/sysctl.d/30-glyndor-epistle.conf ] ||
		[ -L /run/sysctl.d/30-glyndor-epistle.conf ] ||
		[ -e /etc/sysctl.d/30-glyndor-epistle.conf ] ||
		[ -L /etc/sysctl.d/30-glyndor-epistle.conf ]
}

# Print "<uid start> <gid start>" for a new block of $4 subordinate ids
# (65536 when $4 is absent), given login.defs ($1), the subuid table ($2) and
# the subgid table ($3). The block honours SUB_UID_MIN/MAX and SUB_GID_MIN/MAX
# and overlaps no existing entry. The same start serves both tables when one
# is free in both, so the uid and gid mappings line up; otherwise each table
# gets its own.
epistle_subid_starts() {
	subid_size=${4:-65536}
	uid_min=$(epistle_login_def SUB_UID_MIN 100000 "$1")
	uid_max=$(epistle_login_def SUB_UID_MAX 600100000 "$1")
	gid_min=$(epistle_login_def SUB_GID_MIN 100000 "$1")
	gid_max=$(epistle_login_def SUB_GID_MAX 600100000 "$1")
	common_min=$uid_min
	if [ "$gid_min" -gt "$common_min" ]; then
		common_min=$gid_min
	fi
	common_max=$uid_max
	if [ "$gid_max" -lt "$common_max" ]; then
		common_max=$gid_max
	fi
	if common=$(epistle_free_subid_start "$common_min" "$common_max" "$subid_size" "$2" "$3"); then
		echo "$common $common"
		return 0
	fi
	uid_start=$(epistle_free_subid_start "$uid_min" "$uid_max" "$subid_size" "$2") || return 1
	gid_start=$(epistle_free_subid_start "$gid_min" "$gid_max" "$subid_size" "$3") || return 1
	echo "$uid_start $gid_start"
}

# Reject replaceable parents before creating the private executable store.
epistle_rollback_dir() {
	for parent in / /var /var/lib; do
		[ ! -L "$parent" ] && [ -d "$parent" ] \
			&& [ "$(stat -c '%u:%g' -- "$parent")" = 0:0 ] || return 1
		mode=$(stat -c '%a' -- "$parent") || return 1
		[ "$((0$mode & 022))" -eq 0 ] || return 1
	done
	rollback=/var/lib/epistle-rollback
	[ ! -L "$rollback" ] || return 1
	if [ ! -e "$rollback" ]; then
		(umask 077; mkdir -- "$rollback") || return 1
	fi
	[ -d "$rollback" ] && [ "$(stat -c '%u:%g' -- "$rollback")" = 0:0 ] || return 1
	mode=$(stat -c '%a' -- "$rollback") || return 1
	[ "$((0$mode & 022))" -eq 0 ] || return 1
	chmod 0700 -- "$rollback"
}

case "$1" in
configure)
	if ! epistle_rollback_dir; then
		echo "epistle: could not prepare the root-owned rollback store; rollback is unavailable" >&2
	fi

	# 1. The account. --no-create-home because the state directory is created
	# below with the mode the server needs rather than the skeleton's.
	account_ok=true
	if ! epistle_retry 5 epistle_add_account; then
		account_ok=false
		echo "epistle: could not create the glyndor-epistle account, so its directories, subordinate ids, linger, Podman socket and stack update were skipped and the package is configured without them; run sudo dpkg-reconfigure epistle to try again" >&2
	fi

	if [ "$account_ok" = true ]; then
		if [ ! -d /var/lib/glyndor/epistle ]; then
			epistle_install_dir 0700 /var/lib/glyndor/epistle
		else
			epistle_check_dir /var/lib/glyndor/epistle 0700
		fi

		if [ ! -e /var/lib/glyndor/epistle/data ] && [ ! -L /var/lib/glyndor/epistle/data ]; then
			epistle_install_dir 0700 /var/lib/glyndor/epistle/data
		else
			epistle_check_dir /var/lib/glyndor/epistle/data 0700
		fi

		if [ ! -e /etc/epistle ]; then
			epistle_install_dir 0750 /etc/epistle
		else
			epistle_check_dir /etc/epistle 0750
		fi
	fi

	# 2. The subordinate id ranges rootless Podman maps into its containers.
	# Without them `podman` refuses to start a container as this user. The
	# block must be one no other account holds: useradd gives the first regular
	# user 100000 onwards by default, and two accounts mapping the same host ids
	# can each own the other's container files.
	ranges_added=false
	if [ "$account_ok" = true ] && { ! grep -q '^glyndor-epistle:' /etc/subuid 2>/dev/null || ! grep -q '^glyndor-epistle:' /etc/subgid 2>/dev/null; }; then
		if epistle_retry 5 epistle_add_subids; then
			ranges_added=true
		elif [ $? -ne 70 ]; then
			echo "epistle: could not add the subuid/subgid ranges for glyndor-epistle (usermod may have found /etc/subuid or /etc/subgid locked); rootless Podman will not start until they exist, so run sudo dpkg-reconfigure epistle to try again" >&2
		fi
	fi

	# 3. Linger, so the account's user manager (and with it the rootless stack)
	# runs without an open session. Only meaningful when systemd is running.
	# Linger starts the manager in the background, so its runtime directory
	# is waited for below, and only when linger is on.
	manager_wait=1
	if [ "$account_ok" != true ]; then
		:
	elif [ -d /run/systemd/system ]; then
		if ! epistle_retry 5 loginctl enable-linger glyndor-epistle; then
			echo "epistle: loginctl enable-linger glyndor-epistle failed; the rootless services will not start at boot, so run sudo loginctl enable-linger glyndor-epistle" >&2
		else
			manager_wait=10
		fi
	else
		echo "epistle: systemd is not running, so linger was not enabled for glyndor-epistle; epistle init will check it" >&2
	fi

	# podup speaks the libpod API rather than invoking the Podman CLI.
	if [ "$account_ok" = true ] && [ -d /run/systemd/system ]; then
		(
			if ! service_uid=$(id -u glyndor-epistle); then
				echo "epistle: could not look up the uid of glyndor-epistle, so the Podman API socket was not enabled; run systemctl --user enable --now podman.socket as glyndor-epistle" >&2
				exit 0
			fi
			service_runtime=/run/user/$service_uid
			if ! epistle_retry "$manager_wait" test -d "$service_runtime"; then
				echo "epistle: $service_runtime does not exist, so the user manager of glyndor-epistle is not running and the Podman API socket was not enabled; once it runs, run systemctl --user enable --now podman.socket as glyndor-epistle" >&2
				exit 0
			fi
			if ! epistle_retry 5 runuser -u glyndor-epistle -- env \
				XDG_RUNTIME_DIR="$service_runtime" \
				DBUS_SESSION_BUS_ADDRESS="unix:path=$service_runtime/bus" \
				systemctl --user enable --now podman.socket; then
				echo "epistle: could not enable the Podman API socket; run systemctl --user enable --now podman.socket as glyndor-epistle" >&2
			fi
		)
	fi

	# 4. Prepare the rootless Podman runtime for the new ranges. Podman arrives
	# through podup, a Depends, so it is only absent under --force-depends.
	if [ "$ranges_added" = true ] && command -v podman >/dev/null 2>&1; then
		if ! runuser -u glyndor-epistle -- podman system migrate; then
			echo "epistle: podman system migrate failed for glyndor-epistle; epistle init will check the rootless runtime" >&2
		fi
	fi

	# 5. The port floor shipped in /usr/lib/sysctl.d/30-glyndor-epistle.conf.
	# Applying that file with `sysctl -p` sets 25 on every configure, whether
	# or not the administrator kept a different floor in /etc/sysctl.d, and
	# every upgrade would undo their choice. The value is therefore applied
	# only while the operator's configuration says nothing about the key.
	if [ -w /proc/sys/net/ipv4/ip_unprivileged_port_start ] && command -v sysctl >/dev/null 2>&1; then
		if epistle_sysctl_masked; then
			echo "epistle: /etc/sysctl.d/30-glyndor-epistle.conf replaces the packaged file, so the port floor was left as configured there" >&2
		elif override=$(epistle_admin_sysctl_value net.ipv4.ip_unprivileged_port_start) && [ -n "$override" ]; then
			echo "epistle: the local sysctl configuration sets net.ipv4.ip_unprivileged_port_start to $override, so the packaged floor was not applied; epistle init will check the unprivileged port floor" >&2
		elif ! sysctl -p /usr/lib/sysctl.d/30-glyndor-epistle.conf >/dev/null; then
			echo "epistle: sysctl -p /usr/lib/sysctl.d/30-glyndor-epistle.conf failed, so the unprivileged port floor may still be above 25; epistle init will check it" >&2
		fi
	else
		echo "epistle: could not apply /usr/lib/sysctl.d/30-glyndor-epistle.conf; epistle init will check the unprivileged port floor" >&2
	fi

	# 6. Packages up to 0.10.1 gave the account a fixed block that useradd also
	# gives the first regular user, and the step above never moves a block the
	# account already holds. On upgrade, an overlap is moved to a free block of
	# the same size, chosen by the allocator a fresh install uses. `epistle
	# move-subids` stops the stack, rewrites only the account's lines, shifts
	# the owner of its container files, starts the stack again, and puts all
	# of it back when a step fails. It runs before `stack update` below so the
	# stack that update restarts is already on the new block.
	if [ "$account_ok" = true ] && [ -n "${2:-}" ] && { epistle_subid_overlaps /etc/subuid || epistle_subid_overlaps /etc/subgid; }; then
		subid_size=$(epistle_account_subid_size /etc/subuid /etc/subgid)
		if ! subid_starts=$(epistle_subid_starts /etc/login.defs /etc/subuid /etc/subgid "$subid_size"); then
			echo "epistle: glyndor-epistle shares subordinate ids with another account and there is no free block of $subid_size ids within SUB_UID_MIN/MAX and SUB_GID_MIN/MAX to move it to; epistle check subid shows the overlap" >&2
		elif ! epistle move-subids --uid-start "${subid_starts% *}" --gid-start "${subid_starts#* }"; then
			echo "epistle: could not move the subordinate ids of glyndor-epistle (see the message above for what was left in place); run sudo dpkg-reconfigure epistle to try again" >&2
		fi
	fi

	# Only an enabled stack opts into automatic image updates on apt upgrades.
	# Whatever goes wrong here leaves the package configured: the stack is
	# the one part `sudo epistle stack update` can redo afterwards.
	# A run that has just added the ranges (a reconfigure after they failed)
	# has no stack to refresh yet.
	if [ "$account_ok" = true ] && [ "$ranges_added" != true ] && [ -n "${2:-}" ] && [ -f /var/lib/glyndor/epistle/.config/systemd/user/podup-epistle.service ]; then
		(
			if ! service_uid=$(id -u glyndor-epistle); then
				echo "epistle: could not look up the uid of glyndor-epistle, so the stack was not updated; run sudo epistle stack update" >&2
				exit 0
			fi
			HOME=/var/lib/glyndor/epistle
			XDG_RUNTIME_DIR=/run/user/$service_uid
			DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
			export HOME XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS
			if ! cd "$HOME"; then
				echo "epistle: could not enter $HOME, so the stack was not updated; run sudo epistle stack update" >&2
				exit 0
			fi
			# The user manager may be starting again, as it does after
			# `epistle move-subids`. Without an answer from it, "is-enabled"
			# below would fail and be read as a stack that is switched off.
			if ! epistle_retry 10 runuser -u glyndor-epistle -- systemctl --user show-environment >/dev/null 2>&1; then
				echo "epistle: the user manager of glyndor-epistle did not answer, so the stack was not updated; once it runs, run sudo epistle stack update" >&2
				exit 0
			fi
			if runuser -u glyndor-epistle -- systemctl --user is-enabled --quiet podup-epistle.service; then
				if ! runuser -u glyndor-epistle -- epistle stack update; then
					# apt shows maintainer script output, so frame it; the
					# package stays installed either way.
					{
						echo
						echo "**********************************************************************"
						echo "epistle: the stack did not come back healthy after this upgrade."
						echo "epistle: the error above names what failed. Fix it and run"
						echo "epistle:   sudo epistle stack update"
						echo "epistle: or go back to the previous version (and, if the schema"
						echo "epistle: already moved, the database dumped before the restart) with"
						echo "epistle:   sudo epistle stack rollback"
						echo "**********************************************************************"
						echo
					} >&2
				fi
			fi
		)
	fi
	;;
esac

#DEBHELPER#

exit 0
